body
    {
    /* Don't set margins/padding */
    font-family: Arial, Helvetica, Verdana, sans-serif;
    font-size: 10pt;
    }

h2,
h3,
h4,
h5,
h6
    {
    margin-bottom:0;
    padding-bottom:0;
    }

    h1
        {
        font-size:18pt;
        margin: 0; 
        padding: 0;
        }

    h2
        {
        font-size:14pt;
        }

    h3
        {
        font-size:12pt;
        }

    h4
        {
        font-size:11pt;
        }

    h5
        {
        font-size:10pt;
