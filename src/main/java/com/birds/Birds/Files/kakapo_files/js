function scrollToAccordionHash() {
    
    const url = new URL(document.URL);
    if (url.hash !== '') {
        const element = document.getElementById(url.hash.slice(1));
        let accordionPanel
        let searchElement = element;

        if (element) {
            if (element.classList.contains('accordion-item')) {
                const button = element.querySelector('h2 button');
                if (button) {
                    button.click();
                }
                setTimeout(() => {
                    element.scrollIntoView({ behavior: "auto", block: "center", inline: "nearest" });
                }, 0);
                return;
            }

            do {
                if (searchElement.classList.contains('Accordion-panel')) {
                    accordionPanel = searchElement;
                    break;
                }
            } while ((searchElement = searchElement.parentElement) !== document.body);

            if (accordionPanel) {
                const button = document.querySelector('[aria-controls=' + accordionPanel.id + ']');

                if (button) {
                    button.setAttribute('aria-expanded', 'true');
                    accordionPanel.removeAttribute('hidden');
                    element.scrollIntoView({ behavior: "auto", block: "center", inline: "nearest" });
                }
            }
        }
    }
}

