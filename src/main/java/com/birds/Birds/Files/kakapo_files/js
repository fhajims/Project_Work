            $selectMenus: $('.events-filters select.doc-dropdown')
        };
    },
    bindEvents: function () {
        EventFilter.btns.$sumbit.on("click", function (e) {
            e.preventDefault();
            EventFilter.doFilter();
        });
        EventFilter.btns.$reset.on("click", function (e) {
            e.preventDefault();
            EventFilter.reset();
        });
    },
    toggleDateRange: function () {
        var $dateRange = $(".events-filters .date-range"),
            isVisible = EventFilter.fields.$startDate.is(":visible"),
            filterType = EventFilter.fields.$date.val(),
            isRange = filterType === "25"; // See DOC.CMS.Internet.Api.Models.EventDateFilterType for filterTypes

        EventFilter.fields.$startDate.prop("required", isRange);
        EventFilter.fields.$endDate.prop("required", isRange);
        if (isRange && !isVisible) {
            $dateRange.stop().fadeIn(250);
        } else if (!isRange && isVisible) {
            EventFilter.fields.$startDate.val("");
            EventFilter.fields.$endDate.val("");

            $dateRange.stop().fadeOut(250);
        }
    },
    datePickers: function () {
        var startMinDate = new Date(); // Set startDates min date as today
        var endDateMinDate = new Date(startMinDate.getTime() + 24 * 60 * 60 * 1000); // Set endDates min date as tomrrow

        EventFilter.fields.$startDate
              .datepicker("option", {
                  minDate: startMinDate
              })
            .on("change", function () {
                EventFilter.fields.$endDate.datepicker("option", "minDate", DOCForm.getDatepickerDate($(this)));
            });

        EventFilter.fields.$endDate
            .datepicker("option", {
                minDate: endDateMinDate,
                defaultDate: "+1w"
            })
            .on("change", function () {
                EventFilter.fields.$startDate.datepicker("option", "maxDate", DOCForm.getDatepickerDate($(this)));
            });
    },
    createFilter: function () {
        var startDate = DOCForm.getDatepickerDate(EventFilter.fields.$startDate);
        var endDate = DOCForm.getDatepickerDate(EventFilter.fields.$endDate);
        return {
            pageID: EventFilter.fields.$pageID.val(),
            categoryID: EventFilter.fields.$category.val(),
            locationID: EventFilter.fields.$location.val(),
            dateFilter: EventFilter.fields.$date.val(),
            startDate: startDate ? startDate.getFullYear() + "-" + (startDate.getMonth() + 1) + "-" + startDate.getDate() : null,
            endDate: endDate ? endDate.getFullYear() + "-" + (endDate.getMonth() + 1) + "-" + endDate.getDate() : null,
            query: EventFilter.fields.$keyword.val()
        };
    },
    validate: function () {
        var valid = true;
        DOCForm.resetValidator();

        for (var property in EventFilter.fields) {
            if (EventFilter.fields.hasOwnProperty(property) && !EventFilter.fields[property].valid()) {
                valid = false;
                break;
            }
        }
        return valid;
    },
    doFilter: function () {
        var requestData = EventFilter.createFilter();
        if (EventFilter.validate()) {
            requestData.page = EventFilter.fields.$pageNumber.val();
            requestData.count = EventFilter.fields.$itemsPerPage.val();
            EventResults.reset();
            EventResults.fetchResults(requestData);
        }
    },
    reset: function () {
        EventResults.reset();
        EventResults.fields.$defaultSort.prop("checked", true);
        EventFilter.fields.$category.val(0).change();
        EventFilter.fields.$location.val(0).change();
        EventFilter.fields.$startDate.val("");
        EventFilter.fields.$endDate.val("");
        EventFilter.fields.$date.val(0).change();
        EventFilter.toggleDateRange();
        $('.ui-selectmenu-text').css('font-weight', 'normal');
        DOCForm.resetValidator();
        
        EventFilter.fields.$keyword.val("");
        EventFilter.fields.$selectMenus.selectmenu("refresh");
        setTimeout(function () {
            EventFilter.doFilter();
        }, 250);
    }
};

var EventResults = {
    fields: {
        $defaultSort: null,
        $sort: null
    },
    templates: {
        $eventSummary: null,
        eventSummary: null,
        $eventRegionSummary: null,
        eventRegionSummary: null
    },
    $resultList: null,
    $resultsCount: null,
    lastRequestData: null,
    init: function () {
        EventResults.elements();
        EventResults.bindEvents();
    },
    elements: function () {
        EventResults.fields = {
            $defaultSort: $('.events-results input:radio:checked'),
            $sort: $('.events-results [data-filter-name="Sort"]').find("input:radio")
        };

        EventResults.templates = {
            $eventSummary: $('.events-results #templateEventSummary'),
            $eventRegionSummary: $('.events-results #templateEventSummaryByRegion')
        };
        EventResults.templates.eventSummary = EventResults.templates.$eventSummary.html(),
        EventResults.templates.eventRegionSummary = EventResults.templates.$eventRegionSummary.html(),

        EventResults.$resultList = $('.events-results #results-list');
        EventResults.$resultsCount = $('.events-results #results-count');
    },
    bindEvents: function () {
        EventResults.fields.$sort.change(EventResults.changeSort);
    },
    changeSort: function () {
        EventResults.clearResults();
        var requestData = $.extend({}, EventResults.lastRequestData, {
            sort: EventResults.fields.$sort.filter(":checked").val(),
            page: 1
        });
        EventResults.fetchResults(requestData);
    },
    clearResults: function () {
        var $items = EventResults.$resultList.removeClass("results-loading").find(".fade");
        $items.removeClass("in").addClass("out removing");
        setTimeout(function () {
            $items.remove();
        }, 250);
    },
    reset: function () {
        EventResults.clearResults();
        EventResults.lastRequestData = null;
        EventResults.$resultsCount.removeClass("in").addClass("out");
        EventResults.fields.$sort.parents(".fade").removeClass("in").addClass("out");
        EventResults.disableInfinityScroll();
    },
    fetchResults: function (requestData) {
        // Update sort links
        var $selectedSort = EventResults.fields.$sort.filter(':checked');
        $('#results-sort label span').removeClass('no-link');
        $selectedSort.prev('label').children('span').addClass('no-link');
        if (!requestData.sort) requestData.sort = $selectedSort.val();
        // Fetch results
        EventResults.lastRequestData = requestData;
        EventResults.$resultList.addClass('results-loading');
        $.getJSON('/api/events/FindEvents', requestData, function (data) {
            EventResults.showResults(data);
        }).fail(function (jqXhr, status, error) {
            var message = error.toString();
            if (jqXhr && jqXhr.responseJSON) {
                if (jqXhr.responseJSON.ExceptionMessage) {
                    message = jqXhr.responseJSON.ExceptionMessage;
                } else if (jqXhr.responseJSON.Message) {
                    message = jqXhr.responseJSON.Message;
                }
            }
            EventResults.showResults({ error: message });
        }).always(function () {
            window.history.pushState('EnventPage', document.title, window.location.pathname + '?' + $.param(requestData));
            EventResults.$resultList.removeClass('results-loading');
        });;
    },
    enableInfinityScroll: function () {
        $(window).off('scroll.loadmore').on('scroll.loadmore', EventResults.fetchNextPageResults);
    },
    disableInfinityScroll: function () {
        $(window).off('scroll.loadmore');
    },
    // Infinity scroll to load more paged items
    fetchNextPageResults: function () {
        var resultListHeight = EventResults.$resultList.offset().top + EventResults.$resultList.height(),
            winHeight = $(window).scrollTop() + $(window).height();

        // Load more items if bottom of results is on screen and we're not already loading items.
        if ((resultListHeight < winHeight) && !EventResults.$resultList.hasClass("results-loading")) {
            var requestData = $.extend({}, EventResults.lastRequestData, {
                page: parseInt(EventResults.lastRequestData.page) + 1
            });

            EventResults.fetchResults(requestData);
        }
    },
    showResults: function (result) {
        // Check for errors
        var error = null;
        if (!result) {
            error = "Unexpected error rendering results - Empty results";
        } else if (result.error) {
            error = result.error;
        }
        if (error) {
            DOC.OpenDialog(error, "Unable to show results");
            return;
        }
        
        // Display results if any
        if (result.Count > 0) {
            var html, regions = [];

            if (EventResults.lastRequestData.sort === "10") {
                var regionMap = {};
                $.each(result.Items, function () {
                    var event = this;
                    if (typeof (regionMap[event.Region]) == 'undefined') {
                        regionMap[event.Region] = {
                            RegionName: event.Region,
                            RegionSlug: event.Region.trim()
                                        .toLowerCase()
                                        .replace(/\s+/g, "-")
                                        .replace(/[^\w\-]+/g, "")
                                        .replace(/\-\-+/g, "-")
                                        .replace(/^-+/, "")
                                        .replace(/-+$/, ""),
                            Events: []
                        };
                    }
                    regionMap[event.Region].Events.push(event);
                });
                regions = Object.keys(regionMap).map(function (key) { return regionMap[key] });
                html = Mustache.to_html(EventResults.templates.eventRegionSummary, regions);
            } else {
                html = Mustache.to_html(EventResults.templates.eventSummary, result.Items);
            }

            EventResults.$resultList.append(html);
            if (regions.length > 0) {
                $.each(regions, function () {
                    var group = this, $headings = $('.events-results [data-title-for="' + group.RegionSlug + '"]');
                    if ($headings.length > 1) {
                        $headings.slice(1).remove();
                    }
                });
            }

            var $currentItems = EventResults.$resultList.children(":not(.group-header,.removing)");
            if (result.Count <= $currentItems.length) {
                EventResults.disableInfinityScroll();
            } else {
                EventResults.enableInfinityScroll();
            }

            // Remove DOC sort if 'all or none' DOC events
            if (!result.ShowDocSort) {
                EventResults.fields.$sort.filter('[value="20"]').prev('label').hide();
            } else {
                EventResults.fields.$sort.filter('[value="20"]').prev('label').show();
            }

            // Show sort options
            EventResults.fields.$sort.parents('.fade').removeClass('out').addClass('in');
        } else {
            EventResults.reset();
        }

        var s = (result.Count !== 1) ? 's' : '',
            $resCountText = $('<h3>Found ' + result.CountUnique + ' event' + s + '</h3>');
        EventResults.$resultsCount.html($resCountText).removeClass("out").addClass("in");
        EventResults.$resultList.find("> .fade").removeClass("out").addClass("in");

        var showMoreSessions = function (e) {
            e.preventDefault();
            $(this).parent().hide().siblings().removeClass('out').addClass('in');
        };
        EventResults.$resultList.find('.session-list .show-more > a').each(function () {
            var $showMore = $(this);
            if ($showMore.parent().siblings().length > 3) {
                $showMore.trigger("click", showMoreSessions);
            } else {
                $showMore.remove();
            }
        });
    }
};

