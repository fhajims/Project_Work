                    $alertContainer.html('<h2>Alerts</h2><p>No alerts.</p>');
                    $('#alert-panel').remove();
                    return;
                }

                // Format data into Summary or Details template
                var template, plural, headingText;
                // .alert-heading-inner class is the wrapper to support "padding-bottom & overflow:hidden" issue
                var $alertHeading = $('#alert-panel>h2'), $alertHeadingInner = $('#alert-panel>h2>.alert-heading-inner');
                                
                if (isAlertSummary || isPlace) {
                    template = $('#templateAlertSummary').html();
					plural = data.length === 1 && data.Alerts != null && data.Alerts.length === 1 ? '' : 's';
                    $('.doc-text-right', $alertContainer).show();
                    $('#alertsummary').find('#alert-panel > h2').addClass('no-print');

                    headingText = 'Alert' + plural + ' for ' + $alertContainer.data('name');
                    $alertHeading.text(headingText);
                } else {
                    template = $('#templateAlertDetails').html();
					plural = data.length === 1 ? '' : 's';                
                    $('.doc-text-right', $alertContainer).hide();

                    headingText = 'Alert' + plural + ": " + parkAndRec.alerts.generateHeadingText(data); 
                    $alertHeadingInner.text(headingText);
                }
                                
                var html = Mustache.to_html(template, data);

                // Show the alerts panel
                $('#alert-panel').show();
                $alertContainer.append(html);                
                parkAndRec.scroll();

                // Google Analytics event tracking
                if (eventTracking.isEnabled && !isAlertSummary) {
                    // Track load
                    ga('send', 'event', 'Alerts', 'Load', 'N/A', null, true);
                    // Track click
                    $alertHeading.one('click.track', function () {
                        ga('send', 'event', 'Alerts', 'Expand', 'N/A');
                    });
                }

                // Click event handlers for expand/collapse
                var $alertSubHeadings = $('.alert-heading', $alertContainer), $containers = $('.alert-body', $alertContainer);
                $alertHeading.on("click", function () {
					parkAndRec.alerts.readmore.toggle($(this));
					$alertContainer.slideToggle(parkAndRec.alerts.scrollToDisplayed);
                });
                $alertSubHeadings.append(parkAndRec.alerts.readmore.text);
                $alertSubHeadings.on("click", function () {
                    var $this = $(this);
                    parkAndRec.alerts.readmore.toggle($this);
					$this.next('.alert-body').slideToggle(parkAndRec.alerts.scrollToDisplayed);
                });
                $('#alerts-expand').on("click", function () {
                    parkAndRec.alerts.readmore.toggle($alertSubHeadings.filter(function () { return !$(this).hasClass('open'); }));
                    $containers.slideDown();
                    return false;
                });
                $('#alerts-collapse').on("click", function () {
                    parkAndRec.alerts.readmore.toggle($alertSubHeadings.filter('.open'));
                    $containers.slideUp();
                    return false;
				});

				DOC.LoadModule(alertDialog.init);
            })
            .fail(function () {
                $alertContainer.html('<h2>Alerts</h2><p>Error loading alert summary.</p>');
            })
            .always(function () {
                $alertContainer.removeClass('loading');
			});
        },
        readmore: {
            text: '<span class="readmore no-print">Read details..</span>',
            toggle: function($this) {
                $this.toggleClass('open');
                $('.readmore', $this).text($this.hasClass('open') ? 'Hide details..' : 'Read details..');
            }
        }
    },
    // Scroll page after alerts ajax call to make sure we go to the right part of the page.
    scroll: function () {
        // Scroll to the 'Park search' if on a park/place page and there's an activity param
        if ($('#activity-links').length && DOC.GetUrlParams().activity) {
            $('html, body').scrollTop($('#activitypanel').offset().top);
        }
        // Scroll to subpages
        if (history.state != null && history.state.subPageScrollTop) {
