        eventTracking.isEnabled = typeof window.ga === 'function' && window.location.href.indexOf('doc.govt.nz') > -1;
        if (!eventTracking.isEnabled) return;
        eventTracking.master();
        eventTracking.relatedpages();
        eventTracking.localnav();
        if ($('.features-panel').length) eventTracking.multimedia.init();
    },
    getSecondsSinceLastScrollEvent: function () {
        var currentTime = new Date().getTime();
        var difference = (currentTime - eventTracking.lastScrollEventTime) / 1000;

        eventTracking.lastScrollEventTime = currentTime;
        return Math.round(difference);
    },
    // Track file downloads (fileLinks: jQuery object or array of links to documents like PDF, DOC, etc)
    files: function (fileLinks) {
        $(fileLinks).on("click", function () {
            ga('send', 'event', 'Documents', 'Link', this.innerText, this.href);
        });
    },
    master: function () {
        var pageTypeName = $('#pagetype').val();

        // Load event
        ga('send', 'event', 'ScrollDepth', 'Load', pageTypeName, null, true);

        // Scroll event [uses jquery.onscreen plugin (https://github.com/adaptlearning/jquery.onscreen)]
        $('.scrolldepth').on('onscreen', function (event, measurement) {
            if (!$(this).data('scrolldepth-hit')) {
                if (measurement.percentFromTop < 50) {
                    var difference = eventTracking.getSecondsSinceLastScrollEvent();
                    var actionName = $(this).data('scrolldepth-action'); // get the action value

                    $(this).data('scrolldepth-hit', 'true'); // set the hit flag to "true"
                    ga('send', 'event', 'ScrollDepth', actionName, pageTypeName, difference);
                }
            }
        });
    },
    // Track interaction with photos and videos in the feature media panel
    multimedia: {
        photoViews: 0,
        videoSeconds: 0,
        timer: null,
        viewToggle: '',
        init: function () {
            eventTracking.multimedia.viewToggle = $('.features-panel .tabslist').length
                ? 'View - toggle'
                : 'View - no toggle';
            eventTracking.multimedia.photos();
            eventTracking.multimedia.videos();
        },
        // Track 'next' button interaction in carousel and lightbox
        photos: function () {
            var $nextBtn = $('.features-panel .jcarousel-control-next');

            if ($nextBtn.length) {
                $nextBtn.on("click", function () {
                    eventTracking.multimedia.photoViews += 1;
                });
                $(window).unload(function () {
                    ga('send', 'event', 'IntegratedMedia', eventTracking.multimedia.viewToggle, 'Photos', eventTracking.multimedia.photoViews);
                });
            }
        },
        // Track number of seconds video viewed
        videos: function () {
            var $video = $('.features-panel .panel-video iframe');
            if ($video.length) {
                $video.attr('id', 'yt-video');
                // Check YouTube script loaded or listen for callback event
                if (typeof window.YT !== 'undefined')
                    eventTracking.multimedia.createPlayer();
                else {
                    $(window).on('onYouTubeIframeAPIReady', eventTracking.multimedia.createPlayer);
                    //window.onYouTubeIframeAPIReady = eventTracking.multimedia.createPlayer;
                }

                $(window).unload(function () {
                    ga('send', 'event', 'IntegratedMedia', eventTracking.multimedia.viewToggle, 'Video', eventTracking.multimedia.videoSeconds);
                });
            }
        },
        // Load video into YouTube API
        createPlayer: function () {
            var player = new YT.Player('yt-video', {
                events: {
                    'onReady': eventTracking.multimedia.onPlayerReady,
                    'onStateChange': eventTracking.multimedia.onPlayerStateChange
                }
            });
        },
        // YouTube API ready event
        onPlayerReady: function (e) {
            // No tracking required at this time
        },
        // YouTube API change event, count how many seconds video plays
        onPlayerStateChange: function (e) {
            if (e.data == YT.PlayerState.PLAYING) {
                eventTracking.multimedia.timer = setInterval(function () {
                    eventTracking.multimedia.videoSeconds += 1;
                }, 1000);
            }
            if (e.data == YT.PlayerState.PAUSED || e.data == YT.PlayerState.ENDED) {
                clearTimeout(eventTracking.multimedia.timer);
            }
        }
    },
    relatedpages: function () {
        $('.related-page-link').on("click", function (e) {
            e.preventDefault();
            var $this = $(this),
                url = $this.attr('href'),
                type = $this.data('type'),
                pos = $this.index(),
                heading = $('.related-page-heading', $this).text();
            
            ga('send', 'event', 'RelatedLink', type, heading, pos, { 'hitCallback': function() {
                 document.location = url;
