const initMenu = () => {

	const navOpenButton = document.getElementById('pnav-open-button');
	const navCloseButton = document.getElementById('pnav-close-button');
    const nav = document.getElementById('nav-site');
    const navContainer = document.getElementById('nav-site-container');
	const navMenuDiv = document.getElementById('nav-menu-div');
	const navMenuScrollDiv = document.getElementById('nav-menu-scroll-div');
	let navMenuOpen = false;

	navContainer.addEventListener('click', (event) => {
		if (event.target !== navContainer && event.target !== navMenuDiv) {
            return;
        }

        if (navContainer.getAttribute('role') === 'dialog') {
			expandNavMenu(false);
        }
    });

    const expandNavMenu = (expand) => {
        if (expand) {
            navContainer.setAttribute('role', 'dialog');
			document.documentElement.classList.add('nav-menu-open');
			navCloseButton.focus();
			navMenuOpen = true;
        } else {
			navContainer.removeAttribute('role');
			document.documentElement.classList.remove('nav-menu-open');
			navOpenButton.focus();
			navMenuOpen = false;
			if (openMenuButton !== null) {
				openMenuButton.setAttribute('aria-expanded', 'false');
				openMenuButton = null;
			}
        }
    };

    navOpenButton.addEventListener('click', () => {
        expandNavMenu(true);
	});

	navCloseButton.addEventListener('click', () => {
		expandNavMenu(false);
	});

    const menuButtons = document.querySelectorAll('#nav-site-menu > li > button');
    let openMenuButton = null;

    const closeOpenSubMenu = () => {
        if (openMenuButton) {
            openMenuButton.setAttribute('aria-expanded', 'false');
            openMenuButton = null;
        }
    }

    /**
     * Check if the given element is within the given container element
     * @param {HTMLElement} element Element
     * @param {HTMLElement} container Container element
     */
    const elementWithin = (element, container) => {
        do {
            if (element === container) {
                return true;
            }
        } while ((element = element.parentElement) !== document.body);

        return false;
    };

    /**
     * Get the last focussable element within a container element
     * 
     * @param {HTMLElement} container Container element
     */
    const getLastFocusableElement = (container) => {
        const focussable = container.querySelectorAll(
            'a[href]:not([tabindex="-1"]), area[href]:not([tabindex="-1"]), ' +
            'input:not([disabled]:not([tabindex = "-1"]), ' +
            'select:not([disabled]:not([tabindex = "-1"]), ' +
            'textarea:not([disabled]:not([tabindex = "-1"]), ' +
            'button:not([disabled]:not([tabindex = "-1"]), ' +
            'iframe:not([tabindex = "-1"]), ' +
            '[tabindex]:not([tabindex = "-1"]), ' +
            '[contentEditable = true]:not([tabindex = "-1"])'
        );

        return focussable[focussable.length - 1];
    };

    /* Handle pressing the escape key when focus is within the main navigation
     * menu
     */
    document.addEventListener('keyup', (event) => {
        if (event.key !== 'Escape') {
            return;
        }

        // Get currently focussed element
        const activeElement = document.activeElement;

        if (!activeElement) {
            return;
        }

        // Check if the active element is in an menu
        let element = activeElement;
        let submenu = null;

        do {
            if (element.classList.contains('list-item-top')) {
                submenu = element;
                break;
            }

            if (element.id === 'nav-site') {
                break;
            }
        } while ((element = element.parentElement) !== document.body);

        // Ignore if we are not in the menu
        if (element === document.body) {
            return;
        }

        if (submenu && openMenuButton && openMenuButton === submenu.querySelector('button')) {
            // Only close the active submenu if in it
            const button = openMenuButton;
            closeOpenSubMenu();
            button.focus();
            return;
        }

        // Close all the menus
        closeOpenSubMenu();
        expandNavMenu(false);
        // Focus the small screen nav button if it is visible
        if (navCloseButton.offsetParent !== null) {
            navCloseButton.focus();
        }
	});

	window.addEventListener('resize', (event) => {
		if (window.innerWidth >= 767 && navMenuOpen) {
			expandNavMenu(false);
		}
	});

    /* Add focus-within event handler to the main menu to trap focus within
     * menu when closed
     */
    nav.addEventListener('focusout', (event) => {
        // Ignore if the menu is not open
        if (navCloseButton.getAttribute('aria-expanded') !== 'true') {
            return;
        }

        // On the focusout, the relatedTarget will the element that now has
        // the focus, so we can check if that is in our nav. It can also be
        // null when the menu closes using a mouse
        if (event.relatedTarget === null || elementWithin(event.relatedTarget, nav)) {
            return;
        }


        if (event.target === navCloseButton) {
            getLastFocusableElement(nav)?.focus();
        } else {
            navCloseButton.focus();
        }
    });



    for (let button of menuButtons) {
        let timeout = null;
        const id = button.getAttribute('aria-controls');
        const menuDiv = document.getElementById(id);
        const menuContainer = menuDiv.parentElement;

        /**
         * Expand/collapse the current submenu
         * 
         * @param {boolean} expand Whether to expand or collapse the submenu
         */
		const expandMenu = (expand) => {
            if (timeout !== null) {
                clearTimeout(timeout);
                timeout = null;
            }
            if (expand) {
                if (button.getAttribute('aria-expanded') === 'true') {
                    return;
                }
                if (openMenuButton !== null) {
                    openMenuButton.setAttribute('aria-expanded', 'false');
                }
