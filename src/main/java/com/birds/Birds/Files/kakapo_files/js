    // Hit the filter
    doFilter: function () {
        var activity = $('#ActivityHiddenField').val();
        recFilter.selectAllNZ(); // Select All NZ if filters are selected
        if (recFilter.isRegionValue()) {
            switch (activity) {
                case 'walking-tramping':
                    recFilter.filterTracks();
                    break;
                case 'camping':
                case 'campsite':
                    recFilter.filterCampsites();
                    break;
                case 'hunting':
                    recFilter.filterHunting();
                    break;
                case 'mountain-biking':
                    recFilter.filterCycling();
                    break;
                case 'hut':
                    recFilter.filterHuts();
                    break;
                case 'lodge':
                    recFilter.filterLodges();
