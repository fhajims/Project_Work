        epiForm.newsletter.init();
        epiForm.addressChecker();
    },
    // Check address with NZ Post address checker
    addressChecker: function() {
        var cache = {};
        $('.address').autocomplete({
            minLength: 4,
            source: function(request, response) {
                var term = request.term,
                    token = this.element.data('cookietoken') + ' : ' + this.element.data('formtoken');

                if (term in cache) {
                    response(cache[term]);
                    return;
                }

                $.ajax('/api/address/getsuggest/' + term, {
                    type: 'get',
                    contentType: 'application/json',
                    dataType: 'json',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    success: function (data) {
                        if (data != null) {
                            var suggestions = data.map(function(address) {
                                 return address.fullAddress;
                            });
                            cache[term] = suggestions;
                            response(suggestions);
                        } else console.info('epiForm.AddressChecker no data returned.');
                    },
                    error: function(jqXHR, textStatus, errorThrown) {
                        console.error('epiForm.AddressChecker ' + textStatus + ': ' + errorThrown);
                    }
                });
            }
        });
    },
    // Remove empty tables cells and cleanup form
    formatForm: function() {
        // Remove table cells (td) if they are empty (contain non-breaking space &nbsp;)
        // From: http://stackoverflow.com/questions/1294850/set-colspan-dynamically-with-jquery
        $('table#id_matrix tr').each(function () {
            var counter = 0;

            $('td', this).each(function () {
                var $td = $(this);

                // ReSharper disable once CoercedEqualsUsing
                if ($td.html() == "&nbsp;") {
                    counter++;
                    $td.remove();
                }
            });
            if (counter !== 0) {
                $('td:first', this).attr('colSpan', '' + parseInt(counter + 1, 10) + '');
            }
        });

        // Required fields asterisk *
        $('table#id_matrix .requiredfield').prev('label, legend').addClass('required');

        // Add datepicker from jquery.ui
        $("input.date").datepicker({ dateFormat: "dd/mm/yy" });

        // Add 'border' css class to fieldsets if set in editor
        $("input.border").parent("fieldset").addClass("border");
    },
    // Adds Campaign Monitor functionality to forms
    newsletter: {
        fields: {
            $newsletterCheckBoxes: null,
            $email: null,
            $submitBtn: null
        },
		init: function () {
            epiForm.newsletter.fields.$newsletterCheckBoxes = $('.EPiServerForms input[type=checkbox][value^=cm-]');
            epiForm.newsletter.fields.$email = $('.EPiServerForms input[type=text].cm-email');
            epiForm.newsletter.fields.$submitBtn = $('.EPiServerForms button[type=submit]').last();

            // Check for mandatory Campaign Monitor fields
            if (!epiForm.newsletter.fields.$email.length || !epiForm.newsletter.fields.$newsletterCheckBoxes.length) return;

            // Assumes only one form & submit button per page
            epiForm.newsletter.fields.$submitBtn.on('click.epiformNewsletter', function (e) {
                e.preventDefault();

                var $checkedBoxes = epiForm.newsletter.fields.$newsletterCheckBoxes.filter(':checked'),
                    $requiredFields = $('.EPiServerForms .requiredfield').filter(function () { return !this.value; }),
                    email = epiForm.newsletter.fields.$email.val(),
                    promises = [], formData = {};

                // Check required epiForm & Campaign Monitor fields are completed
                if ($requiredFields.length || !email || !$checkedBoxes.length) {
                    epiForm.newsletter.submit();
                    return;
                }

                // Get form data for other Campaign Monitor fields
                var $cmFormFields = $('textarea[class*=cm-], select[class*=cm-], input[type=text][class*=cm-], input:checked[class*=cm-]', '.EPiServerForms').not('.cm-email');
                $cmFormFields.each(function () {
                    var $this = $(this), val = $this.val();

                    // Check field has value
                    if (!val) return true; // continue

                    // Find key in list of classes
                    var classes = $this.attr('class').split(' '), key = '';
                    for (var i = 0; i < classes.length; i++) {
                        if (classes[i].startsWith('cm-')) {
                            key = classes[i];
                            break;
                        }
                    }
                                
                    // Add checkbox values as arrays
                    if ($this.attr('type') == 'checkbox') {
                        if (key in formData) {
                            formData[key].push(val);
                        } else {
                            formData[key] = [val];
                        }
                        return true; // continue
                    }

                    formData[key]= val;
                });

                // Loop through checkboxes and create deferred subscription tasks
                $checkedBoxes.each(function () {
                    var data = formData,
                        chkBxClass = $(this).attr('value'),
                        chkBxClassArray = chkBxClass.split('-'),
                        formName = chkBxClassArray.length > 1 ? chkBxClassArray[chkBxClassArray.length -1]: '',
                        action = 'https://departmentofconservationnewzealand.createsend.com/t/i/s/' + formName + '?callback=?';

                    data[chkBxClass]= email;

                    // Create promise for each subscription
                    if (formName) {
                        promises.push($.getJSON(action, data, function (result) {
                            if (result.Status === 200) {
                                // Ignore response. 400 = error, 200 = OK, message = data.Message
                            }
                        }));
                    }
                });

                // Remove click event and resubmit form after promises are complete
                $.when.apply($, promises).done(function () {
                    epiForm.newsletter.submit();
                });
            });
        },
        submit: function() {
            epiForm.newsletter.fields.$submitBtn.off('click.epiformNewsletter').trigger("click");
        }
    }
};

// Survey popup
var survey = {
    fluidDialog: function () {
        var $visible = $(".dialogFixed:visible");
        // Each open dialog
        $visible.each(function () {
            var $this = $(this);
            var dialog = $this.find(".ui-dialog-content").data("ui-dialog");
            // If fluid option == true
            if (dialog.options.fluid) {
                var wWidth = $(window).width();
                // Check window width against dialog width
                if (wWidth < (parseInt(dialog.options.maxWidth) + 50)) {
                    // Keep dialog from filling entire screen
                    $this.css("max-width", "90%");
                } else {
                    // Fix maxWidth bug
                    $this.css("max-width", dialog.options.maxWidth + "px");
                }
                // Reposition dialog
                dialog.option("position", dialog.options.position);
            }
        });
    },
    init: function () {
        // check for the SurveyCookie
        var popupCookieName = 'SurveyCookie';
        if ($('#popupCookieName').length) {
            popupCookieName = $('#popupCookieName').val();
		}
        var surveyCookie = DOC.GetCookie(popupCookieName), $dialogSurvey = $("#dialog-survey");
	    var isMobileMedia = window.matchMedia("only screen and (max-width: 760px)");
		var isSurveyMobileOnly = $("#pnlSurvey").data("mobileonly") === "True";
		var delayPopupMilliseconds = 0;
		if ($('#delayMillisecondsPlaceHolder').length)
			delayPopupMilliseconds = $('#delayMillisecondsPlaceHolder').val();

		if (!isMobileMedia.matches && isSurveyMobileOnly) {
			return;
		}

        if (typeof surveyCookie !== 'undefined') {
            if (surveyCookie === "False") {
                // overwrite the SurveyCookie, reset the expiry time to a year in the future (3 weeks)
                document.cookie = popupCookieName + '=False;expires=' + DOC.GetExpiryTime(30240) + '; path=/';
            }
		} else {

			// #2374, #2104, #2658
			setTimeout(function () {
				$dialogSurvey.dialog({
					resizable: false,
					modal: false,
					fluid: true,
					position: { my: 'right bottom', at: 'right bottom', of: window, collision: 'none' },
                    dialogClass: 'dialogFixed',
                    close: function (event, ui) {
                        //it's for '.ui-dialog-titlebar-close', which tag is generated after init; other buttons click event will overwrite it. 
                        document.cookie = popupCookieName + '=True;expires=' + DOC.GetExpiryTime(30) + '; path=/';
					}
				});
            }, delayPopupMilliseconds);

			$('.button, a', $dialogSurvey)
