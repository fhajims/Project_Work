var layoutHelpers = {
    init: function() {
        layoutHelpers.helpers();
        window.addEventListener("orientationchange", function(e) {
            layoutHelpers.helpers();
        });
    },

    helpers: function() {
        // Generic layout helper functions. Parts of the layout need some pretty fiddly things to happen,
        // So I'm keeping them here for now
        // Note that these will be replaced in Vue, and thank god for that
        var isMobile = window.outerWidth > 0 && window.outerWidth <= 480;
        var isMobileLandscape = window.outerWidth > 0 && window.outerWidth <= 767;

        // Set mobile hero element size
        if (isMobile || isMobileLandscape) {
            // This is actually just 'conditional' CSS, as the page header having the secondary heading means different space is needed
            // Im not happy with it, but nothing seems to behave how I am expecting it to, so for now its just here
            var isSecondHeader = $('#section-main.hero-image-set #page #page-header p').length;
            if (!isSecondHeader) {
                var hero = $('#section-main.hero-image-set #page .page-hero');
                hero.addClass('mobile-hero-no-secondary');
            }
        }

        // Move any action buttons on mobile
        if (isMobile) {
            // This is not best practice, but seeing as we are redoing the layout and UI it can stay for now 
            var ctaButton = $('#online-action-buttons .online-action');
            ctaButton.remove();
            if ($('.introduction-main-container .my-wishlist-container').length) {
                ctaButton.insertBefore('.intro-container .introduction-main-container .my-wishlist-container');
            } else {
                ctaButton.insertBefore('.introduction-main-container .introduction-text-container');
            }

            var productSet = $('#online-action-buttons .product-set');
            productSet.remove();
            if ($('.introduction-main-container .my-wishlist-container').length) {
                productSet.insertAfter('.introduction-main-container .wishlist-wrapper');
            } else {
                productSet.insertBefore('.introduction-main-container .introduction-text-container');
            }
        }

        // When there is no hero image set, the header needs to readjust the size of the hero image
        // Again, not a nice way to do this but with the header positioned from the bottom it grows upwards
        if (!isMobile) {
            if ($('.page-hero #page-header h1').length) {
                var topHeader = $('#section-main.no-hero .page-hero #page-header h1');
                if (topHeader.height() > 44) {
                    // The header is on 2 lines
                    var currentHeight = $('#page .page-hero').height();
                    var newHeight = currentHeight + 44;
                    $('#page .page-hero').height(newHeight.toString() + 'px');
                }
            }
        }


        if (!isMobile) {
            // Same for breadcrumbs
            if ($('.page-hero #breadcrumbnav').length) {
                var topHeader = $('#section-main.no-hero .page-hero #breadcrumbnav');
                if (topHeader.height() > 19) {
                    // The breadcrumb is on 2 lines
                    var currentHeight = $('#page .page-hero').height();
                    var newHeight = currentHeight + 19;
                    $('#page .page-hero').height(newHeight.toString() + 'px');
                }
            }
        }


        // On mobile, we need to extend the size of the hero to accommodate for extra lines in the second header
        // This is positioned absolute, which would push the heading upwards
        if (isMobileLandscape) {
            var heading = $('#page-header');
            heading.remove();
            heading.insertAfter('#page .page-hero');
        }
    }
}

// SVG image maps
var svgMaps = {
    init: function () {
        var $hoverImg = $('#hoverimage'),
            baseImgHref = $('#baseimage').attr('xlink:href');

        // Handle base map and hover images
        $('#svgcontainer a')
            .hover(
                function () { $hoverImg.attr('xlink:href', $(this).data('image')); },
                function () { $hoverImg.attr('xlink:href', baseImgHref); }
            );

        // Show popups (if showpopups flag has been set as a class)
        $('#svgcontainer.showpopups a')
            .hover(function () {
                var $this = $(this),
                    $popup = $('#popup' + $this.attr('id'));

                if ($popup.length) {
                    $popup.show();
                } else {
                    var $div = $('<div>',
                        {
                            id: 'popup' + $this.attr('id'),
                            'class': 'svgpopup',
                            style: 'top: ' + $this.data('top') + 'px; left: ' + $this.data('left') + 'px;'
                        }),
                        $divContent = $('<div>', { 'class': 'mainContent' }),
                        name = '<h3>' + $this.data('name') + '</h3>',
                        intro = '<p>' + $this.data('intro') + '</p>',
                        img = '<img src="' + $this.data('thumburl') + '" alt="' + $this.data('thumbalt') + '" />';

                    $divContent.append(name);
                    $divContent.append(img);
                    $divContent.append(intro);
                    $div.append('<div class="hoverTop"></div>');
                    $div.append($divContent);
                    $div.append('<div class="hoverBottom"></div>');
                    $div.appendTo('#svgcontainer');
                    $div.show();
                }
            },
                function () { $('[id^="popup"]').hide(); }
            );
    }
};

