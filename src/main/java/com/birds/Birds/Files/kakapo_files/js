// Browser feature checks and common elements
var framework = {
	init: function () {
        framework.deactivate_non_javascript_fallbacks();
        framework.add_touchscreen_class();
        framework.tabs();
    },
    // So that in CSS you can have selectors like ".javascript-capable .fallback_element_to_hide_in_new_browsers {display:none}"
    deactivate_non_javascript_fallbacks: function () {
        $('body').addClass('javascript-capable');
    },
    // Add a touchscreen class for mobiles/tablets
    add_touchscreen_class: function () {
        if (DOC.IsMobile()) $('body').addClass('touch-screen');
    },
    // List/Map view tabs on some templates (promotion, GIS maps)
    tabs: function () {
        var $tabs = $('#tabs');
        if (!$tabs.length) return; // no tabs

        var $mapLoaded = false;
        var $tabsView = $('#tabs-view');
        if ($tabsView.length) {
            $tabs.tabs({
                active: $tabsView.val().toLowerCase() === "mapview" ? 1 : 0,
                // Set hidden field value to enable back button support
                // and initialize maps if necessary
                activate: function (event, ui) {
                    switch (ui.newPanel.attr('id')) {
                        case 'mapview':
                            $tabsView.val('mapview');
                            if (!$mapLoaded) {
                                newMapHandler.loadIframeMap();
                                newMapHandler.mousewheelOverlay();
                                $mapLoaded = true;
                            }
                            break;
                        case 'listview':
                            $tabsView.val('listview');
                            break;
                    }
                },
                // Show tabs if there is a 'map view' and initialize maps if necessary
                create: function (event, ui) {
                    if ($('#mapview').children('div').length > 0) {
                        $('#tabs-list').css('display', 'inline-block');
                    }

                    if ($tabsView.val().toLowerCase() === 'mapview') {
                        newMapHandler.loadIframeMap();
                        newMapHandler.mousewheelOverlay();
                        $mapLoaded = true;
                    }
                }
            });
        } else $('#listview').show();
    }
};

