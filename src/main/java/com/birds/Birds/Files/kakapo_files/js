                var selectedDateValue = $("select[data-filter-name='DateFilter'").find(':selected').text();
                var locSelector = "span:contains('" + selectedDateValue + "')";
                $(locSelector).css("font-weight", "bold");
            }
        });
    },
    datepickers: function () {
        $(".doc-form .doc-datepicker").datepicker({
            dateFormat: "dd/mm/yy",
            beforeShow: function (textbox, instance) {
                var $textbox = $(textbox);
                $textbox.parent().append(instance.dpDiv.addClass("doc-datepicker"));
                var $textBoxPos = $textbox.position();
                $.datepicker._pos = [$textBoxPos.left + parseInt($textbox.css('marginLeft')), $textBoxPos.top + parseInt($textbox.css('marginTop'))];
            }
        });
    },
    getDatepickerDate: function ($pickerEl) {
        var thisDate = null;

        try {
            var dateFormat = $pickerEl.datepicker("option", "dateFormat");
            var dateValue = $pickerEl.val();
            if (dateFormat && dateValue) {
                thisDate = $.datepicker.parseDate(dateFormat, dateValue);
            }
        } catch (e) {
        }
        return thisDate;
    },
    validator: function () {
        $.validator.setDefaults({
            errorPlacement: function (error, element) {
                var $error = $(error),
                    $element = $(element);
                $error.width($element.width()).css({ position: "absolute", "border-top": "none" });
                $element.after($error);
                $error.position({
                    my: "left top",
                    at: "left bottom",
                    of: $element
                });
            }
        });
        $.validator.methods.date = function (value, element) {
            var valid, $element = $(element);
            if ($element.hasClass("hasDatepicker")) {
                var dateVal = DOCForm.getDatepickerDate($element);
                valid = (dateVal instanceof Date);
            } else {
                valid = !/Invalid|NaN/.test(new Date(value).toString());
            }

            return valid;
        };
    },
    resetValidator: function () {
        $(".doc-form label.error").remove();
        $(".doc-form .doc-form-control.error").removeClass("error");
    }
};

