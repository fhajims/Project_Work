                    if (recFilter.isParkFilter) recFilter.filterParks();
                    else if (recFilter.isTrackAndParksFilter) recFilter.filterTracksAndParks();
                    break;
            }
        }
    },
    // Run the search/filter
    filter: function () {
        var $resultsList = $('#results-list'), sort = $('#sortby').val(), count = 10;

        // Get the page state from the history API if search has already run
        if (history.state) {
            recFilter.state.scrollTop = history.state.scrollTop || 0;
            recFilter.state.page = history.state.page || 1;
        }

        // Set vars for 'load more' requests
        recFilter.dataObject.count = count;
        recFilter.dataObject.page = recFilter.dataObject.page || 1; // 'Next' page to download

        // Initialise results and paging on first request
        if (recFilter.dataObject.page === 1) {
            // Clear results list
            $resultsList.html('');
            // Set 'has searched' setting for edge case in 'recFilter.init'
            recFilter.state.hasSearched = true;
            // Check if user has pushed back button by checking the history state and download more results if so
            recFilter.dataObject.count = count * recFilter.state.page;
        }

        // Spin the spinner
        $resultsList.append('<li class="loading"></li>');

        // Set the sort
        if (sort) {
            recFilter.dataObject.sort = sort;
            $('a[id|="sort"]').removeClass('selected');
            switch (sort) {
                case 'place':
                    $('#sort-place').addClass('selected');
                    break;
                case 'popular':
                    $('#sort-popular').addClass('selected');
                    break;
                default:
                    $('#sort-name').addClass('selected');
                    break;
            }
        }

        // Get the results from API.
        $.getJSON(recFilter.jsonPath, recFilter.dataObject, function (data) {
            var activity = $('#ActivityHiddenField').val();

            // Initialise count and headings on page 1 of results.
            if (recFilter.dataObject.page === 1) {
                var s = data.Count !== 1 ? 's' : '', countText,
                    placeSortActivities = [
                        'campsite', 'camping', 'four-wheel-driving', 'hunting', 'horse-riding', 'hut', 'kayaking-canoeing',
                        'lodge', 'mountain-biking', 'scenic-driving', 'trail-biking', 'walking-tramping'
                    ];

                // Set count text
                switch (activity) {
                    case '':
                        countText = 'found';
                        break;
                    case 'walking-tramping':
                        countText = 'for walking and tramping tracks';
                        break;
                    case 'camping':
                    case 'campsite':
                        countText = 'for camping/campsites';
                        break;
                    case 'hunting':
                        countText = 'for hunting blocks';
                        break;
                    case 'mountain-biking':
                        countText = 'for mountain biking tracks';
                        break;
                    case 'hut':
                        countText = 'for huts';
                        break;
                    case 'lodge':
                        countText = 'for lodges, cabins and cottages';
                        break;
                    case 'concessionaires':
                        countText = 'for commercial operators';
                        break;
                    default:
                        countText = 'for ' + $('#filters-activity-header-link').text().toLowerCase();
                }

                // Set results count
                $('#results-count').html('<h3>' + data.CountUnique + ' result' + s + ' ' + countText + '</h3>');

                // Show the place sort for secondary activities which return tracks and places (kayaking, etc)
                if ($.inArray(activity, placeSortActivities) > -1) $('.place-sort').show();

                // GA Event Tracking
                if (eventTracking.isEnabled) ga('send', 'event', 'Filters', recFilter.pageName, JSON.stringify(recFilter.dataObject), null);

                recFilter.dataObject.page = recFilter.state.page + 1; // Increment pager by state pager plus one
            } else {
                // Increment pagers by one
                recFilter.state.page += 1;
                recFilter.dataObject.page += 1;
            }

            // Display results if any
            if (data.Count > 0) {
                var html = Mustache.to_html(recFilter.template, data.Items),
                    isConcessionaireFilter = activity === 'concessionaires';
                if (isConcessionaireFilter) {
                    $('#results-sort').hide();
                } else {
                    html = recFilter.formatItems(html);
                    $('#results-sort').show();
                }
                $resultsList.append(html);

                // Re-initialize 'external links' for concessionaire results
                if (isConcessionaireFilter) {
                    var linkIcons = $resultsList.linkicons();
                    eventTracking.files(linkIcons.linksNewWindow);
                }

                // Check if there are more results to load (check >= as data.Count is not zero-based)
                if (data.Count >= $resultsList[0].children.length)
                    recFilter.loadMore();
                else
                    $(window).off('scroll.loadmore');

                // Scroll to result on back button
                if (recFilter.state.scrollTop) {
                    $('html, body').scrollTop(recFilter.state.scrollTop);
                    recFilter.state.scrollTop = 0; // Don't keep scrolling!
                }

                // Save scroll position to History API when visitor selects a result
                $('a', $resultsList).off('click.filterHistory').on('click.filterHistory', function () {
                    recFilter.state.scrollTop = $(window).scrollTop(); // Update scroll position
                    history.replaceState(recFilter.state, 'Parks and Recreation Search', null);
                });

            } else {
                $('#results-sort').hide();
                $(window).off('scroll.loadmore');
            }

            // Save state to History API
            history.replaceState(recFilter.state, 'Parks and Recreation Search', null);
        })
        .fail(function (jqXhr, status, error) {
            $resultsList.append('<li>' + error.toString() + '<br/><br/></li>');
        })
        .always(function () {
            $('li.loading', $resultsList).remove();
        });
    },
