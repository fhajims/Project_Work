            parkAndRec.subpages.state.subPageScrollTop = 0;
        } else if (parkAndRec.subpages.$subpages && parkAndRec.subpages.$subpages.length && window.location.href.indexOf('#page-id') > -1) {
            $('html, body').scrollTop($('#subpages').offset().top).scroll();
