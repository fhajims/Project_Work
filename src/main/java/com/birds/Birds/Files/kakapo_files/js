                    }
                }
            });
            if (DOC.GetUrlVar('categoryID') > 0) {
                var selectedCategoryValue = $("select[data-filter-name='CategoryID'").find(':selected').text();
                var catSelector = "span:contains('" + selectedCategoryValue + "')";
                $(catSelector).css("font-weight", "bold");
            }
            if (DOC.GetUrlVar('locationID') > 0) {
                var selectedLocationValue = $("select[data-filter-name='LocationID'").find(':selected').text();
                var locSelector = "span:contains('" + selectedLocationValue + "')";
