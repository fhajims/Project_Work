                });

            $('#no')
                .on("click", function () {
                    document.cookie = popupCookieName + '=False;expires=' + DOC.GetExpiryTime(30240) + '; path=/';
                });

            $('#remind')
                .on("click", function () {
                    document.cookie = popupCookieName +'=True;expires=' + DOC.GetExpiryTime(30) + '; path=/';
                });            
        }

        $(window).on("resize", function () { survey.fluidDialog(); });

        // catch dialog if opened within a viewport smaller than the dialog width
