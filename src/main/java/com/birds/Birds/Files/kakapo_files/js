    },
    // What's up DOC subscription
    newsletter: function () {
        // Subscribe button event handler
        $('#subscribebutton').on("click", function (e) {
            e.preventDefault();
            if ($('#footer-subscribe input[name=place]').val()) return; // Honeypot spambot check.
            $.getJSON($(this).data('action') + '?callback=?', { 'cm-name': $('#cm-name').val(), 'cm-huaz-huaz': $('#cm-huaz-huaz').val() }, function (data) {
                // 400 = error, 200 = OK, message = data.Message
                if (data.Status === 200) {
                    DOC.OpenDialog('Your subscription has been confirmed. You\'ve been added to our list and will hear from us soon.', 'Newsletter subscription');
                } else {
                    DOC.OpenDialog('Sorry, there was an error with the subscription. Please verify your email address is entered correctly.', 'Newsletter subscription failed');
                }
            });
        });
        // Handle 'Enter' key submission
        $('#footer-subscribe').autosubmit();
    },
    // Remove duplicate menu items from mobile side menu if there are any (for example from 'other links')
    sidemenu: function () {
        var alreadyIncluded = {};
        $('#sidemenu li')
            .each(function () {
                var item = $(this).text().trim() + " - " + $(this).attr('href');

                if (alreadyIncluded[item]) {
                    $(this).remove();
                } else {
                    alreadyIncluded[item] = true;
                }
            });
    },
    // Page tools when scrolling
    backToTop: function () {
        var $backToTopIcon = $('#backtotop'), $footerHr = $('#footer hr').last();
        if (!$backToTopIcon.length || !$footerHr.length) return;
        var backToTopIconBottom = Number($backToTopIcon.css('bottom').replace('px', '')) || 20;

        // Show/hide tools ('Back to top')
        $(window).on('scroll resize', function () {
            var $this = $(this), scrollTop = $this.scrollTop();

            // Hide tool
            if (scrollTop <= 0) {
                $backToTopIcon.fadeOut();
                return;
            }

            // Show tool
            var f = $footerHr.offset().top, scrollBottom = scrollTop + $this.height();
            if ($backToTopIcon.is(':hidden')) $backToTopIcon.fadeIn();

            if (f <= scrollBottom) { // Stop back to top from scrolling when footer on screen
                var footerBottom = backToTopIconBottom + (scrollBottom - f);
                $backToTopIcon.css('bottom', footerBottom + 'px');
            } else $backToTopIcon.css('bottom', backToTopIconBottom + 'px');
        });

        // Back to top click
        $('#backtotop').on("click", function () {
            $('body,html').animate({ scrollTop: 0 }, 1200, 'easeOutExpo');
        });
    }
};

