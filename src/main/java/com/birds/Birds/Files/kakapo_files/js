        gisMaps.sendMapViewerMessage(gisMaps.mapSettings.messages.showGeolocateButton, [false]);
        gisMaps.sendMapViewerMessage(gisMaps.mapSettings.messages.showIWantToButton, [gisMaps.isLightboxViewer]);
        gisMaps.sendMapViewerMessage(gisMaps.mapSettings.messages.showLayerList, [false]);
        gisMaps.sendMapViewerMessage(gisMaps.mapSettings.messages.showZoomButtons, [true]);
        gisMaps.sendMapViewerMessage(gisMaps.mapSettings.messages.showScaleBarCordinates, false);

        // IMPORTANT to zoom and select features FIRST before turning on/off map layers & services. 
        // Both 'centreAndZoom' and 'selectFeatures' both run zooms so we have some checks and callback functions to take care of different situations.

        // Show layers if no Assets or zoom provided (ie All NZ map)
        if (!gisMaps.campsiteAssetIds && !gisMaps.hutAssetIds && !gisMaps.trackAssetIds && !gisMaps.isZoom) {
            gisMaps.showLayers();
            return;
        }

        // Select features if no zoom set
        if (!gisMaps.isZoom) {
            gisMaps.selectFeaturesNoZoom();
            return;
        }

        // Zoom the map and then either show layers or select features
        var params = gisMaps.centreZoom.split(','); // Add the centre/zoom values
        params.push($.isEmptyObject(gisMaps
                .idValues)
            ? "showLayers"
            : "selectFeaturesNoZoom"); // Add the appropriate callback function
        gisMaps.sendMapViewerMessage(gisMaps.mapSettings.messages
            .centreAndZoom,
            params); // Call the centreAndZoom message
    },
    // Callback from map service after message is sent
    onMapViewerMessage: function (e) {
        var message;

        try {
            message = JSON.parse(e.data);
        } catch (err) {
            console.error('Error parsing message to JSON: ' + err);
        }

        if (typeof message != 'undefined' && message != null) {
            var functionToCall = window.gisMaps[message.command], parameters = message.parameters || [];

            if (functionToCall) {
                functionToCall.apply(null, parameters);
            } else {
                console.error('HOST PAGE ERROR: The map viewer attempted to call "' +
                    message.command +
                    '", but no such function exists.');
            }
        }
    }
};

