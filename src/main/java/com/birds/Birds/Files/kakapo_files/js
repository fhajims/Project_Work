};

// Initialize search dropdown lists and form fields
var recSearch = {
    isRegionProfile: false,
    park_heading: '',
    pageId: '',
    // Hide dropdowns and set event listeners
    init: function () {
        recSearch.isRegionProfile = $('#placestogopage.container').length > 0;
        recSearch.park_heading = $('#filters-park-header-link').text();
        recSearch.pageId = $('#PageId').val();
        recSearch.headings();
        recSearch.clicks();
        recSearch.hidden_select();
        recSearch.mouseup();
        recSearch.search_go();
        recSearch.SortAZ();
        recSearch.SortPopular();
        recSearch.SortPlace();
        recSearch.SetupRegionMap();
        if ($('#results.filter-results').length) DOC.LoadModule(recFilter.init);
    },
    // Add heading to list and 'disabled' class if list is empty
    headings: function () {
        $('a.dropdown-header')
            .each(function () {
                var ddList = $(this).parent().next('ul');
                ddList.prepend('<li class="selected"><a href="#" data-value="">' + $(this).text() + '</a></li>');
                if (ddList.children().length <= 1) {
                    $(this).addClass('disabled');
                }
            });
    },
    // Handle click events for links and filters
    clicks: function () {
        // Region/Activity/Place dropdowns
        $('#searchparks a:not(#go, #select-region-map)').off('click.dropdowns').on('click.dropdowns', function (e) {
            e.preventDefault();
            var $this = $(this);
            if ($this.hasClass('disabled')) {
                return;
            }
            if ($this.hasClass('dropdown-header')) {
                $this.parent().next('ul').show().css('z-index', '5').find('a').first().focus();
            } else {
                recSearch.dropDown($this);
            }
        });
    },
    // Make selections from hidden fields (ie when someone hits the 'back' button)
    hidden_select: function () {
        var r = $('#RegionHiddenField').val(), p = $('#ParkHiddenField').val(), a = $('#ActivityHiddenField').val();
        // Park only
        if (p && !r && !a) {
            recSearch.loadParks();
            return;
        }
        // Region and Activity
        if (r && a) {
            recSearch.dropDown($('a[data-value="' + r + '"]'), true);
            // Don't load parks here, the Activity field will do that
            recSearch.dropDown($('a[data-value="' + a + '"]'));
            return;
        }
        // Region or Activity
        if (r) recSearch.dropDown($('a[data-value="' + r + '"]'));
        if (a) recSearch.dropDown($('a[data-value="' + a + '"]'));
    },
    // Hide dropdowns when user clicks outside of list
    mouseup: function () {
        $(document)
            .mouseup(function (e) {
                var searchContainer = $('#searchpanel ul.dropdown-list'),
                    filterContainer = $('#searchpanel .check-box-dropdown .options');

                // Region/Activity/Place dropdowns
                if (!searchContainer.is(e.target) // if the target of the click isn't the container...
                    &&
                    searchContainer.has(e.target).length === 0) // ... nor a descendant of the container
                {
                    searchContainer.hide();
                    searchContainer.prev().show();
                }

                // Filter dropdowns
                if (!filterContainer.is(e.target) // if the target of the click isn't the container...
                    &&
                    filterContainer.has(e.target).length === 0) // ... nor a descendant of the container
                {
                    if (!$(e.target).closest('div.check-box-dropdown').length) {
                        filterContainer.hide();
                        $('#searchpanel .check-box-dropdown legend').removeClass('rotate180');
                    }
                }
            });
    },
    // Dropdown ($a = selected anchor, stopSearch = load parks [true|false, default = false])
    dropDown: function ($a, stopSearch) {
        $a = $a.first();
        var $div = $a.closest('div'), $ul = $('ul', $div);

        // Make the selection
        $div.next('input').val($a.data('value'));
        $ul.hide().children().removeClass('selected');
        $a.parent('li').addClass('selected');

        // Set the label
        var fontWeight = $('li', $ul).first().hasClass('selected') ? 'normal' : 'bold';
        $('h3 a', $div).text($a.text()).css('font-weight', fontWeight);

        // Load park list when region or activity chosen from dropdowns
        stopSearch = Boolean(stopSearch) || false;
        if (!stopSearch && ($ul.hasClass('region') || $ul.hasClass('activity'))) recSearch.loadParks();
    },
    // Load parks from specific region
    loadParks: function () {
        var parkOption = '<li class="selected"><a href="#" data-value="">' + recSearch.park_heading + '</a></li>';
        var region = $('#RegionHiddenField').val();
        var park = $('#ParkHiddenField').val();

        if (region && region !== 'all') {
            var openHuntingArea = $('#ActivityHiddenField').val().indexOf('hunting') > -1 ? true : false;
            var template = $('#dropdown-template').html();

            $('#filters-park-header-link').addClass('loading-list');
            $('#filters-region-header-link').addClass('disabled');

            $.getJSON('/api/profiles/parklinks', { region: region, openhuntingarea: openHuntingArea }, function (data) {
                var html = Mustache.to_html(template, data);

                $('.park.dropdown-list').html(html);
                $('.park.dropdown-list').prepend(parkOption);
                recSearch.dropDown($('.park.dropdown-list li.selected a'));

                if ($('.park.dropdown-list li').length <= 1) {
                    $('#filters-park-header-link').addClass('disabled');
                }

                // Add extra padding between the last highlighted option in the list and the next item.
                $("#filters-park-list li.highlight:last").next().addClass("unhighlight-top");

                // Select park from hidden field now that park list should be available.
                // This should only run if a park is pre-selected (ie it's in the hidden field on 
                // page load when a user hits the 'back button' or chooses an activity.
                if (park) recSearch.dropDown($('a[data-value="' + park + '"]'));

                // Re-initialize click handler
                recSearch.clicks();
            })
            .fail(function (jqXhr, status, error) {
                DOC.OpenDialog(error.toString());
            })
            .always(function () {
                $('#filters-park-header-link').removeClass('loading-list');
                $('#filters-park-header-link').removeClass('disabled');
                $('#filters-region-header-link').removeClass('disabled');
            });
        } else {
            $('#filters-park-header-link').html(recSearch.park_heading).addClass('disabled');
            $('.park.dropdown-list').html(parkOption);
            $('#ParkHiddenField').val('');
        }
    },
    // Perform search
    search_go: function () {
        $('#Go').on('click.search', function (e) {
            var region = $('#RegionHiddenField').val(),
                park = (region === 'all') ? '' : $('#ParkHiddenField').val(),
                activity = $('#ActivityHiddenField').val(),
                errorMsg = '';

            // Prevent form submit so we can do some validation
            e.preventDefault();

            // Stop here if we're on an activity page (there's a filter template for 'primary' or 'secondary' activities)
            // and run the search on the page.
            if (recFilter.isParkFilter || recFilter.isTrackAndParksFilter) {
                recFilter.doFilter();
                return;
            }

            // If activity, check to see if there are assets available [Campsites, Huts, Lodges, etc] in the park/region
            // Else check to see if a region or park is selected
            if (activity) {
                $.getJSON('/api/profiles/hasprofiles',
                        { region: region, park: park, activity: activity },
                        function (data) {
                            // Display alert if no assets
                            if (!data) {
                                var activityDisplayName = $('#filters-activity-list li.selected').text(),
                                    parkDisplayName = $('#filters-park-list li.selected a').data('value')
                                        ? $('#filters-park-list li.selected').text()
                                        : $('#filters-region-list li.selected').text();

                                if (activityDisplayName.indexOf('campsite') >= 0) {
                                    errorMsg = "<p>There are no campsites in <b>" + parkDisplayName + "</b>. </p>";
                                } else if (activityDisplayName.indexOf('hut') >= 0) {
                                    errorMsg = "<p>There are no huts in <b>" + parkDisplayName + "</b>. </p>";
                                } else if (activityDisplayName.indexOf('lodge') >= 0) {
                                    errorMsg = "<p>There are no lodges, cabins, cottages in <b>" + parkDisplayName + "</b>. </p>";
                                } else {
                                    var tryAnother = (recSearch.isRegionProfile)
                                        ? "Select another activity or try another place."
                                        : "Select another activity or try another region/place.";

                                    errorMsg = "<p>No information is available about <b>" + activityDisplayName.toLowerCase() + "</b> in <b>" + parkDisplayName + "</b>. " + tryAnother + "</p>";
                                }
                            }
                        })
                    .fail(function (jqXhr, status, error) {
                        errorMsg = error.toString();
                    })
                    .always(function () {
                        recSearch.search_go_submit(errorMsg);
                    });
            } else {
                if (!region) {
                    errorMsg = '<p>Please select either "' +
                        $('.region.dropdown-list li').first().text() +
                        '" or "' +
                        $('.activity.dropdown-list li').first().text() +
                        '".</p>';
                } else if (region === 'all') {
                    errorMsg = '<p>Please select a particular region if you don\'t know "' +
                        $('.activity.dropdown-list li').first().text() +
                        '".</p>';
                } else if (!park && recSearch.isRegionProfile) {
                    errorMsg = '<p>Please select either "' +
                        $('.park.dropdown-list li').first().text() +
                        '" or "' +
                        $('.activity.dropdown-list li').first().text() +
                        '".</p>';
                }
                recSearch.search_go_submit(errorMsg);
            }
        });
    },
    // Submit search or display error message
    search_go_submit: function (errorMsg) {
        if (errorMsg) {
            DOC.OpenDialog(errorMsg);
        } else {
            var $region = $('#filters-region li.selected a'),
                region = $region.data('value') || 'all',
                $park = $('#filters-park li.selected a'),
                park = $park.data('value'),
                $activity = $('#filters-activity li.selected a'),
                activity = $activity.data('value'),
                actionId = '?actionId=' + recSearch.pageId;

            // Go to park page
            if (park) {
                var activityString = activity ? '&activity=' + activity : '';
                window.location = $park.attr('href') + actionId + activityString;
                return;
            }

            // Go to activity page
            if (activity) {
                window.location = $activity.attr('href') + actionId + '&region=' + region + '#activitypanel';
                return;
            }

            // Go to region page
            window.location = $region.attr('href') + actionId;
        }
    },
    // Sort results alphabetically
    SortAZ: function () {
        $('#sort-name')
            .on("click", function (e) {
                e.preventDefault();
                $('#sortby').val('az');
                recFilter.doFilter();
            });
    },
    // Sort results by place
    SortPlace: function () {
        $('#sort-place')
            .on("click", function (e) {
                e.preventDefault();
                $('#sortby').val('place');
                recFilter.doFilter();
            });
    },
    // Sort results by popularity
    SortPopular: function () {
        $('#sort-popular')
            .on("click", function (e) {
                e.preventDefault();
                $('#sortby').val('popular');
                recFilter.doFilter();
            });
    },
    // Pop-up region map
    SetupRegionMap: function () {
        $('#select-region-map')
            .fancybox({
                parent: 'form:first',
                titleShow: true,
                titlePosition: 'inside',
                scrolling: 'no',
                fitToView: false,
                maxWidth: "100%",
                beforeShow: function () { $('.fancybox-skin').css('background-color', '#e5f5fe'); },
                afterShow: function () {
                    // Check if click events already bound (in case map is re-opened)
                    $('#svgcontainer a')
                        .off('click.region')
                        .on('click.region',
                            function (event) {
                                var region = $(this).data('name');
                                if (region) {
                                    // Strip punc., w/s chars so we can (hopefully!) find the relevant value in the region dropdown
                                    region = region.replace(/[\.,-\/#!$%\^&\*;:{}=\-_`~() +'’]/g, '').toLowerCase();
                                    recSearch.dropDown($('a[data-value="' + region + '"]'));
                                    $.fancybox.close();
                                    event.preventDefault();
                                }
                            });
                }
            });
    }
};

// Search filters
var recFilter = {
    $activityLinks: null,
    isParkFilter: false,
    isTrackAndParksFilter: false,
    hasAutoFilters: false,
    pageName: '',
    jsonPath: '',
    dataObject: '',
    template: '',
    state: {
        scrollTop: 0,
        page: 1,
        hasSearched: false
    },
    // Initialise recreation search filters
    init: function () {
        // Setup properties
        recFilter.$activityLinks = $('#activity-links');
        recFilter.isParkFilter = Boolean($('#templateParks').length);
        recFilter.isTrackAndParksFilter = Boolean($('#templateTracksParks').length);
        recFilter.hasAutoFilters = Boolean($('#activity-filters').length);
        recFilter.pageName = $('#PageName').val();

        // Filter button event handler
        $('#FilterButton')
            .on("click", function (e) {
                e.preventDefault();
                if ($('#searchpanel input:checked').length || recFilter.isRegionValue()) {
                    recFilter.doFilter();
                } else {
                    if (! $('#RegionHiddenField').val()) {
                        DOC.OpenDialog('Select what you want to search for.');
                    }
                }
            });

        // Reset button event handler
        $('#Reset')
            .on('click',
                function () {
                    // Clear filter dropdowns and hidden fields
                    $("#searchpanel input").each(function () { $(this).prop('checked', false); });
                    $("#searchparks, .filter-results-options")
                        .find("input[type=hidden]:not(#ActivityHiddenField)")
                        .each(function () { $(this).val(''); });
                    $("#searchpanel legend")
                        .each(function () {
                            var $this = $(this);
                            $('.dot-dot-dot', $this).remove();
                            $('.selection', $this).css('font-weight', 'normal').val($this.data('legend'));
                        });

                    // Set the drop down header to the text of the first li
                    $("#searchpanel .dropdown")
                        .each(function () {
                            $('.dropdown-header', this)
                                .text($(this).find('.dropdown-list li a').first().text())
                                .css('font-weight', 'normal');
                        });

                    // Remove the selected class from all the li
                    $('#searchpanel .dropdown-list li').each(function () { $(this).prop('class', ''); });

                    // Disable place dropdown
                    $('#filters-park-header-link').addClass('disabled');

                    // Reset history
                    if (history.state) {
                        recFilter.state.scrollTop = 0;
                        recFilter.state.page = 1;
                        recFilter.state.hasSearched = false;
                        history.pushState(recFilter.state, 'Parks and Recreation Search', null);
                    }
                });

        // Multi-select dropdowns handler
        $('#searchpanel .check-box-dropdown .selection-overlay')
            .off('click.filterdropdowns')
            .on('click.filterdropdowns',
                function () {
                    var dropdownContainer = $(this).closest('.check-box-dropdown'),
                        filterDropdown = $('div.options', dropdownContainer);
                    $('#searchpanel .check-box-dropdown div.options').not(filterDropdown).hide();
                    $('#searchpanel .check-box-dropdown legend')
                        .not($('legend', dropdownContainer))
                        .removeClass('rotate180');
                    filterDropdown.toggle();
                    $('legend', dropdownContainer).toggleClass('rotate180');
                });

        // Multi-select dropdowns handler/initializer
        $('#searchpanel .check-box-dropdown li')
            .on("click", function (e) {
                var $checkbox = $('input[type=checkbox]', this), $fieldset = $checkbox.closest('fieldset');

                e.preventDefault();
                e.stopPropagation(); // Stop click event from firing twice because of nested checkbox inputs
                $checkbox.prop('checked', !$checkbox.prop('checked'));

                if (recFilter.hasAutoFilters) { // Run filter if on the park/place page
                    recFilter.displaySelection($fieldset, 20);
                    recFilter.doFilter();
                } else recFilter.displaySelection($fieldset, 22);

            })
            .each(function () {
                recFilter.displaySelection($(this).closest('fieldset'), recFilter.hasAutoFilters ? 20 : 22);
            });

        // Set up Park/Place activity buttons
        if (recFilter.$activityLinks.length) {
            recFilter.activityLinks.init();
            return;
        }

        // Run search if a search parameter provided or search run previously (ie back button)
        // 'hasSearched' is a special case where a visitor aborts a search on an activity page for 
        // example by visiting the 'about difficulties' page before hitting the 'search' button
        var params = DOC.GetUrlParams();
        if ((params.region || params.park || params.activity) || (history.state != null && history.state.hasSearched)) {
            // Clear park value so we don't loop forward if user hits back button
            if (recFilter.isParkFilter || recFilter.isTrackAndParksFilter) $('#ParkHiddenField').val('');
            recFilter.doFilter();
        }
    },
    // Activity links in search panel on park/place profiles
    activityLinks: {
        init: function () {
            var t;
            recFilter.activityLinks.sizeTabsInit();
            window.onresize = function () {
                clearTimeout(t);
                t = setTimeout(recFilter.activityLinks.sizeTabsInit, 200);
            };
            recFilter.activityLinks.selectActivity();
        },
        sizeTabsInit: function () {
            if ($(window).width() > 768) {
                recFilter.activityLinks.parkMenuLandscape();
            } else {
                recFilter.activityLinks.parkMenuPortrait();
            }
        },
        parkMenuLandscape: function () {
            $('.dropdown-arrow, a', recFilter.$activityLinks).off('click.parkDDMenu');
            $('.temp-item', recFilter.$activityLinks).remove();
        },
        parkMenuPortrait: function () {
            $('.tab-button', recFilter.$activityLinks).last().addClass('last');
            if ($('.tab-button.selected', recFilter.$activityLinks).height() > 20) {
                $('.tab-button.selected', recFilter.$activityLinks).css('padding-top', '6px');
            }

            $('span.dropdown-arrow, a.tab-button.selected', recFilter.$activityLinks)
                .off('click.parkDDMenu')
                .on('click.parkDDMenu',
                    function (e) {
                        if (recFilter.$activityLinks.hasClass('showing')) {
                            e.preventDefault();
                            recFilter.activityLinks.closeParkDropdown();
                        } else {
                            e.preventDefault();
                            recFilter.activityLinks.openParkDropdown();
                        }
                    });
        },
        closeParkDropdown: function () {
            $('.dropdown-arrow', recFilter.$activityLinks).removeClass('doc-ui-rotate180');
            recFilter.$activityLinks.height(50);
            recFilter.$activityLinks.removeClass('showing');
            $('.temp-item', recFilter.$activityLinks).remove();
            if ($('.tab-button.selected', recFilter.$activityLinks).height() > 20) {
                $('.tab-button.selected', recFilter.$activityLinks).css('padding-top', '6px');
            }
        },
        openParkDropdown: function () {
            var links = $('a', recFilter.$activityLinks), heights = 50;

            $('.dropdown-arrow', recFilter.$activityLinks).addClass('doc-ui-rotate180');
            links.each(function () { heights += ($(this).height() + 30); });
            $('.tab-button.selected', recFilter.$activityLinks).removeAttr('style');
            recFilter.$activityLinks.height(heights + 1);
            recFilter.$activityLinks.addClass('showing');
            recFilter.$activityLinks.prepend('<a id="closeParkDD" class="temp-item" href="#">' +
                $('a.selected', recFilter.$activityLinks).text() +
                '</a>');
            $('#closeParkDD')
                .on('click',
                    function (e) {
                        e.preventDefault();
                        recFilter.activityLinks.closeParkDropdown();
                    });
        },
        selectActivity: function () {
            var $links = $('a.tab-button', recFilter.$activityLinks), $activityHiddenField = $('#ActivityHiddenField');

            // Click handler
            $links.on("click", function (e) {
                var $this = $(this), activity = $this.data('activity'),
                    $resultContainers = $('#results-count, #results-sort, #results-list, #activity-filters .filter-heading'),
                    $otherContainer = $('#filterOtherActivities');

                e.preventDefault();
                if ($this.hasClass('selected')) return;

                // Select link
                $links.removeClass('selected');
                $this.addClass('selected');

                // Show appropriate filter link
                $('#activity-filters > div').hide();
                $($this.data('filter')).show();
                $otherContainer.hide();

                // Filter or display containers
                if (activity === 'other-activities') {
                    $resultContainers.hide();
                    $otherContainer.show();
                } else {
                    $resultContainers.show();
                    if (activity === 'campsite camping') activity = 'campsite';
                    $activityHiddenField.val(activity);
                    recFilter.doFilter();
                    if (activity === 'concessionaires') {
                        $('#activity-filters .filter-heading').hide();
                    }
                }
            });
            $('a[data-activity*=' + $activityHiddenField.val() + ']', recFilter.$activityLinks).trigger("click");
        }
    },
    // Format multi-select label text
    displaySelection: function ($fieldset, maxCharacters) {
        var $legend = $('legend', $fieldset),
            $selection = $('.selection', $legend),
            checkedValues = $('input:checkbox:checked', $fieldset)
                .map(function () {
                    return $(this).parent().find('label').text();
                })
                .get()
                .join(", ");

        // Format the dropdown selection text
        $('.dot-dot-dot', $legend).remove();
        $selection
            .val(checkedValues ? checkedValues : $legend.data('legend'))
            .removeClass('truncate')
            .css('font-weight', checkedValues ? 'bold' : 'normal');

        // Add '...' if the length exceeds the max characters
        if ($selection.val().length >= maxCharacters) {
            $selection.addClass('truncate').after('<span class="dot-dot-dot">...</span>');
        }
    },
    // Display an error dialog if no region selected
    isRegionValue: function () {
        if ($('#RegionHiddenField').val()) {
            return true;
        } else {
            return false;
        }
    },
    // Format each link in result set
    formatItems: function (html) {
        var formattedHtml = '',
            params = {},
            park = $('#ParkHiddenField').val(),
            region = $("#RegionHiddenField").val(),
            activity = $('#ActivityHiddenField').val(),
            actionId = $('#ActionId').val(),
            activityId = $('#ActivityI').val();

        // Put the HTML into a jquery object, excluding text notes (type 3).
        var $html = $(html).filter(function () { return this.nodeType !== 3; });

        // Hide or show each alert
        $('.alert', $html)
            .each(function () {
                var $this = $(this), countItem = Number($this.text()), plural = Boolean(countItem > 1) ? 's' : '';
                if (countItem > 0) $this.text(countItem + ' current alert' + plural);
                else $this.remove();
            });

        // Add the required parameters to the query string so we can pass these to the page
        // to build a breadcrumb that reflects the path they took.
        if (region) params.region = region;
        if (park) params.park = park;
        if (activity) params.activity = activity;
        if (actionId) params.actionId = actionId;
        if (activityId && activityId !== '0') params.activityId = activityId;
        var qs = '?' + $.param(params) + '#activitypanel';

        $('a', $html).each(function () {
            var $this = $(this);
            $this.attr("href", $this.attr("href") + qs);
        });

        // Hide location string on park/place pages (Activity links available)
        if (recFilter.$activityLinks.length) $('.profile-location', $html).each(function () { $(this).remove(); });

        // Convert array back to HTML
        $html.each(function () {
            var $this = $(this);
            if (typeof $this != 'undefined' && $this != null) formattedHtml += $this.prop('outerHTML');
        });

        return formattedHtml;
    },
    // Infinity scroll to load more paged items
    loadMore: function () {
        var $window = $(window), $resultsList = $('#results-list');

        $(window).off('scroll.loadmore').on('scroll.loadmore', function () {
            var btnHeight = $resultsList.offset().top + $resultsList.height(),
                winHeight = $window.scrollTop() + $window.height();

            // Load more items if bottom of results is on screen and we're not already loading items.
            if ((btnHeight < winHeight) && ($('li.loading', $resultsList).length === 0)) {
                recFilter.filter();
            }
        });
    },
    // Set region to "All NZ" from dropdown IF region is empty AND any filters are selected or park/parktrack filter is present
    selectAllNZ: function () {
